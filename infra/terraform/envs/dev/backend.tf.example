# Copy this file to backend.tf after the bootstrap layer creates the state bucket.
# Replace the placeholders with the bootstrap outputs for your own AWS account.
# Do not commit backend.tf with real bucket names or account-specific values.

terraform {
  backend "s3" {
    bucket       = "REPLACE_WITH_BOOTSTRAP_STATE_BUCKET"
    key          = "llm-rag-infra-platform/envs/dev/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true
  }
}
