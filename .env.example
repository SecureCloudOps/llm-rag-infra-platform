QDRANT_URL=http://localhost:6333
COLLECTION_NAME=documents-minilm-v2-acl
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
EMBEDDING_DIMENSIONS=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=/tmp/rag-models
LLM_PROVIDER=mock
OMP_NUM_THREADS=2

# Configure an actual trusted OIDC provider; these are placeholders, not a bundled IdP.
OIDC_ISSUER=https://identity.example.invalid/realms/rag
OIDC_AUDIENCE=rag-api
OIDC_JWKS_URL=https://identity.example.invalid/realms/rag/protocol/openid-connect/certs
# Required for Compose: generate a strong private service key; never commit its value.
QDRANT_API_KEY=
